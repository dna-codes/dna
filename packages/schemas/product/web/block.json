{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.codes/schemas/product/web/block",
  "title": "Block",
  "description": "A Block is a named, reusable section within a Page. It maps from an Operation and has a structural type (list, detail, form, actions, etc.).",
  "type": "object",
  "allOf": [{ "$ref": "https://dna.codes/schemas/meta/stability" }],
  "required": ["name", "type"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The PascalCase name of the block.",
      "examples": ["LoanList", "LoanDetail", "ApplyForm", "LoanActions"]
    },
    "type": {
      "type": "string",
      "description": "The structural type of the block.",
      "enum": ["list", "detail", "form", "survey", "actions", "table", "summary", "empty-state"]
    },
    "description": {
      "type": "string",
      "description": "A human-readable explanation of what this block does."
    },
    "operation": {
      "type": "string",
      "description": "The Operation this block maps from, expressed as Resource.Action.",
      "pattern": "^[A-Z][a-zA-Z]*\\.[A-Z][a-zA-Z]*$",
      "examples": ["Loan.View", "Loan.Apply", "Loan.Approve"]
    },
    "fields": {
      "type": "array",
      "description": "The Fields shown or collected in this block.",
      "items": { "$ref": "https://dna.codes/schemas/product/core/field" }
    }
  },
  "examples": [
    { "name": "LoanList", "type": "list", "operation": "Loan.List" },
    {
      "name": "ApplyForm",
      "type": "form",
      "operation": "Loan.Apply",
      "fields": [
        { "name": "amount", "type": "number", "required": true },
        { "name": "term_months", "type": "number", "required": true }
      ]
    }
  ]
}
