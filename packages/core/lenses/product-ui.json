{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna.codes/lenses/product-ui",
  "allOf": [{ "$ref": "https://dna.codes/lenses/base" }],
  "name": "Product UI",
  "nodes": [
    { "slot": "app", "type": "App" },
    { "slot": "module", "type": "Module" },
    { "slot": "workflow", "type": "Workflow" },
    { "slot": "page", "type": "Page" },
    { "slot": "section", "type": "Section" },
    { "slot": "component", "type": "Component" },
    { "slot": "element", "type": "Element" },
    { "slot": "uiOperation", "type": "UIOperation" },
    { "slot": "endpoint", "type": "Endpoint" },
    { "slot": "namespace", "type": "Namespace" },
    { "slot": "resource", "type": "Resource" },
    { "slot": "operation", "type": "Operation" },
    { "slot": "field", "type": "Field" },
    { "slot": "domain", "type": "Domain" },
    { "slot": "group", "type": "Group" },
    { "slot": "process", "type": "Process" },
    { "slot": "task", "type": "Task" }
  ],
  "edges": [
    { "from": "app", "to": "module", "via": "contains" },
    { "from": "module", "to": "workflow", "via": "contains" },
    { "from": "module", "to": "page", "via": "contains" },
    { "from": "workflow", "to": "page", "via": "contains" },
    { "from": "page", "to": "section", "via": "contains" },
    { "from": "section", "to": "component", "via": "contains" },
    { "from": "component", "to": "element", "via": "contains" },
    { "from": "component", "to": "resource", "via": "renders" },
    { "from": "component", "to": "uiOperation", "via": "triggers" },
    { "from": "uiOperation", "to": "page", "via": "navigates_to" },
    { "from": "uiOperation", "to": "operation", "via": "calls" },
    { "from": "element", "to": "field", "via": "requires" },
    { "from": "uiOperation", "to": "resource", "via": "updates" },
    { "from": "app", "to": "domain", "via": "realized_as" },
    { "from": "app", "to": "group", "via": "realized_as" },
    { "from": "module", "to": "domain", "via": "realized_as" },
    { "from": "module", "to": "process", "via": "realized_as" },
    { "from": "workflow", "to": "process", "via": "realized_as" },
    { "from": "page", "to": "process", "via": "realized_as" },
    { "from": "page", "to": "task", "via": "realized_as" },
    { "from": "section", "to": "task", "via": "realized_as" },
    { "from": "component", "to": "operation", "via": "realized_as" },
    { "from": "namespace", "to": "domain", "via": "realized_as" },
    { "from": "endpoint", "to": "operation", "via": "exposes" }
  ]
}
