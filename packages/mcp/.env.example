# DNA MCP Server environment.
# Copy to `.env` and run with:  node --env-file=.env dist/bin.js   (or: npm start)
# bin.ts reads process.env only — it does NOT auto-load this file.

# Port the server listens on (default 3300)
DNA_MCP_PORT=3300

# Starter pack to seed a fresh / empty store: operational | crm | hr (default operational)
DNA_PACK=operational

# ── Persistence ──────────────────────────────────────────────────────────────
# Set all three to use Neo4j (graph persists across restarts). Leave them unset
# to use the in-memory store (zero-config, resets on restart).
# A local Neo4j: docker compose -f ../api/docker-compose.yml up -d neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=devpassword
