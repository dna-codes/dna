  "triggers": [
    {
      "id": "9358d3c7-0c56-4a4e-95fb-e68098a1e154",
      "type": "trigger",
      "version": "1",
      "operation": "Patient.Admit",
      "source": "user",
      "name": "PatientAdmitUser"
    },
    {
      "id": "8466d6a1-e093-49a1-8200-1fb1545d65c4",
      "type": "trigger",
      "version": "1",
      "process": "MedicationOrderFlow",
      "source": "operation",
      "after": "Prescription.Write",
      "name": "MedicationOrderFlowOperation"
    },
    {
      "id": "5cd439f7-7a1b-49d5-984d-15ed737725b4",
      "type": "trigger",
      "version": "1",
      "process": "DischargeFlow",
      "source": "user",
      "description": "AttendingPhysician initiates discharge planning.",
      "name": "DischargeFlowUser"
    }
  ],
  "rules": [
    {
      "id": "4083dbe3-3bc8-4755-a042-0a566ed034ef",
      "type": "rule",
      "version": "1",
      "operation": "Patient.Admit",
      "rule_type": "access",
      "allow": [
        {
          "role": "AttendingPhysician"
        }
      ],
      "name": "PatientAdmitAccess"
    },
    {
      "id": "1dbd1233-b95d-4c6a-8206-0536483eec14",
      "type": "rule",
      "version": "1",
      "operation": "Patient.Discharge",
      "rule_type": "access",
      "allow": [
        {
          "role": "AttendingPhysician"
        }
      ],
      "name": "PatientDischargeAccess"
    },
    {
      "id": "57facc93-059c-4e39-9abc-57103c91efd5",
      "type": "rule",
      "version": "1",
      "operation": "Encounter.Open",
      "rule_type": "access",
      "allow": [
        {
          "role": "AttendingPhysician"
        },
        {
          "role": "ConsultingSpecialist"
        },
        {
          "role": "PrimaryNurse"
        }
      ],
      "name": "EncounterOpenAccess"
    },
    {
      "id": "20fff24c-0813-4b61-a40b-fa83980624a2",
      "type": "rule",
      "version": "1",
      "operation": "Order.Place",
      "rule_type": "access",
      "allow": [
        {
          "role": "AttendingPhysician"
        }
      ],
      "name": "OrderPlaceAccess"
    },
    {
      "id": "4e8580c0-2090-4b43-a7c9-4c8034a4138e",
      "type": "rule",
      "version": "1",
      "operation": "Prescription.Write",
      "rule_type": "access",
      "allow": [
        {
          "role": "AttendingPhysician"
        }
      ],
      "name": "PrescriptionWriteAccess"
    },
    {
      "id": "17f6845c-dcce-4c35-b7a5-d0183ffb3ba3",
      "type": "rule",
      "version": "1",
      "operation": "Prescription.Review",
      "rule_type": "access",
      "allow": [
        {
          "role": "Pharmacist"
        }
      ],
      "name": "PrescriptionReviewAccess"
    },
    {
      "id": "014f5b7d-b0b4-4628-9962-c129447cf688",
      "type": "rule",
      "version": "1",
      "operation": "Prescription.Approve",
      "rule_type": "access",
      "allow": [
        {
          "role": "Pharmacist"
        }
      ],
      "name": "PrescriptionApproveAccess"
    },
    {
      "id": "867fc7c9-834a-46a9-8689-79505522951b",
      "type": "rule",
      "version": "1",
      "operation": "Prescription.Reject",
      "rule_type": "access",
      "allow": [
        {
          "role": "Pharmacist"
        }
      ],
      "name": "PrescriptionRejectAccess"
    },
    {
      "id": "e20d4d02-3b61-45e2-9d88-70311fccfce1",
      "type": "rule",
      "version": "1",
      "operation": "Prescription.Administer",
      "rule_type": "access",
      "allow": [
        {
          "role": "PrimaryNurse"
        }
      ],
      "name": "PrescriptionAdministerAccess"
    },
    {
      "id": "515e1a6e-aad3-427b-a80c-463436363318",
      "type": "rule",
      "version": "1",
      "name": "PatientIsAdmitted",
      "operation": "Order.Place",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "patient.status",
          "operator": "eq",
          "value": "admitted"
        }
      ]
    },
    {
      "id": "c831a65c-bc80-4ef1-80e4-1ad9efb69f33",
      "type": "rule",
      "version": "1",
      "name": "PrescriptionIsPendingReview",
      "operation": "Prescription.Review",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "prescription.status",
          "operator": "eq",
          "value": "pending_review"
        }
      ]
    },
    {
      "id": "749ea11d-2751-4582-8497-206fdbc270d3",
      "type": "rule",
      "version": "1",
      "name": "PrescriptionIsApproved",
      "operation": "Prescription.Administer",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "prescription.status",
          "operator": "eq",
          "value": "approved"
        }
      ]
    },
    {
      "id": "5ab33516-7dff-438a-aea4-4a129d14a9e2",
      "type": "rule",
      "version": "1",
      "name": "DoseWithinSafeRange",
      "operation": "Prescription.Approve",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "prescription.dose_mg",
          "operator": "gt",
          "value": 0
        },
        {
          "attribute": "prescription.dose_mg",
          "operator": "lt",
          "value": 1000
        }
      ]
    },
    {
      "id": "f4cffe5e-d0aa-428e-ad9d-fbf5b346461d",
      "type": "rule",
      "version": "1",
      "name": "AllOrdersResolved",
      "operation": "Patient.Discharge",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "patient.outstanding_orders_count",
          "operator": "eq",
          "value": 0
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "d76877ac-96bc-4e4e-95aa-46a534445d20",
      "type": "relationship",
      "version": "1",
      "name": "Encounter.patient",
      "from": "Encounter",
      "to": "Patient",
      "cardinality": "many-to-one",
      "attribute": "patient_id"
    },
    {
      "id": "eb9e4a35-70e0-4986-9242-634f85a24f8c",
      "type": "relationship",
      "version": "1",
      "name": "Order.patient",
      "from": "Order",
      "to": "Patient",
      "cardinality": "many-to-one",
      "attribute": "patient_id"
    },
    {
      "id": "e00034de-bf2c-43dc-ab47-96b0615a5913",
      "type": "relationship",
      "version": "1",
      "name": "Prescription.patient",
      "from": "Prescription",
      "to": "Patient",
      "cardinality": "many-to-one",
      "attribute": "patient_id"
    }
  ],
  "tasks": [
    {
      "id": "36f247b9-1d34-46cf-b064-7b7a1139a568",
      "type": "task",
      "version": "1",
      "name": "write-prescription",
      "actor": "AttendingPhysician",
      "operation": "Prescription.Write"
    },
    {
      "id": "019952ad-a467-4f03-bf65-001ef0671e83",
      "type": "task",
      "version": "1",
      "name": "review-prescription",
      "actor": "Pharmacist",
      "operation": "Prescription.Review"
    },
    {
      "id": "5ec065a9-de08-461b-90ed-72d497abcc0c",
      "type": "task",
      "version": "1",
      "name": "approve-prescription",
      "actor": "Pharmacist",
      "operation": "Prescription.Approve"
    },
    {
      "id": "0b44a1f7-9347-4bf1-8f47-3cd22ea10ada",
      "type": "task",
      "version": "1",
      "name": "reject-prescription",
      "actor": "Pharmacist",
      "operation": "Prescription.Reject"
    },
    {
      "id": "32be3b17-7f45-42e4-a604-32c8d8bb445b",
      "type": "task",
      "version": "1",
      "name": "administer-prescription",
      "actor": "PrimaryNurse",
      "operation": "Prescription.Administer"
    },
    {
      "id": "94a01639-da3a-4212-813d-974312369860",
      "type": "task",
      "version": "1",
      "name": "discharge-patient",
      "actor": "AttendingPhysician",
      "operation": "Patient.Discharge"
    }
  ],
  "processes": [
    {
      "id": "c7e7102a-baa1-4eae-9982-bf730a7c0cf0",
      "type": "process",
      "version": "1",
      "name": "MedicationOrderFlow",
      "description": "From physician's prescription through pharmacist review to nurse administration.",
      "operator": "AttendingPhysician",
      "startStep": "review",
      "steps": [
        {
          "id": "review",
          "task": "review-prescription",
          "conditions": [
            "PrescriptionIsPendingReview"
          ]
        },
        {
          "id": "approve",
          "task": "approve-prescription",
          "depends_on": [
            "review"
          ],
          "conditions": [
            "DoseWithinSafeRange"
          ],
          "else": "reject"
        },
        {
          "id": "reject",
          "task": "reject-prescription",
          "depends_on": [
            "review"
          ]
        },
        {
          "id": "administer",
          "task": "administer-prescription",
          "depends_on": [
            "approve"
          ],
          "conditions": [
            "PrescriptionIsApproved"
          ]
        }
      ]
    },
    {
      "id": "a22705e1-50e9-4590-80d5-35584aa83f68",
      "type": "process",
      "version": "1",
      "name": "DischargeFlow",
      "description": "Verify all open Orders are resolved before discharging.",
      "operator": "AttendingPhysician",
      "startStep": "discharge",
      "steps": [
        {
          "id": "discharge",
          "task": "discharge-patient",
          "conditions": [
            "AllOrdersResolved"
          ],
          "else": "abort"
        }
      ]
    }
  ]
}
