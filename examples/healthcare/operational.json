{
  "domain": {
    "name": "inpatient",
    "description": "Hospital inpatient ward — Patient-centered care team. Patient is a Person template (structure with medical attributes and lifecycle); Roles like AttendingPhysician are scoped TO that Patient (Role.scope can target a Person, not just a Group). The Patient is the per-Patient organizational context; the Pharmacy is a traditional Group scoping Pharmacist Memberships."
  },
  "resources": [
    {
      "id": "652bb47a-21f4-4243-8db4-a551b6378cc7",
      "type": "resource",
      "version": "1",
      "name": "Encounter",
      "description": "A single clinical interaction with a Patient (rounds, intake, exam).",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "patient_id",
          "type": "reference",
          "resource": "Patient",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "values": [
            "intake",
            "rounds",
            "consult",
            "discharge"
          ]
        },
        {
          "name": "occurred_at",
          "type": "datetime"
        }
      ],
      "actions": [
        {
          "name": "Open",
          "type": "write"
        },
        {
          "name": "Close",
          "type": "write"
        }
      ],
      "domain": "inpatient"
    },
    {
      "id": "a204af8c-ce66-4d7a-9f00-4277701faff9",
      "type": "resource",
      "version": "1",
      "name": "Order",
      "description": "A clinical order (medication, lab, imaging) placed against a Patient.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "patient_id",
          "type": "reference",
          "resource": "Patient",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "values": [
            "medication",
            "lab",
            "imaging",
            "diet"
          ]
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "active",
            "completed",
            "cancelled"
          ]
        }
      ],
      "actions": [
        {
          "name": "Place",
          "type": "write"
        },
        {
          "name": "Cancel",
          "type": "destructive"
        },
        {
          "name": "Complete",
          "type": "write"
        }
      ],
      "domain": "inpatient"
    },
    {
      "id": "3943b5c4-31b0-4112-acc0-5db8b024f682",
      "type": "resource",
      "version": "1",
      "name": "Prescription",
      "description": "A medication order requiring pharmacist sign-off and nurse administration.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "patient_id",
          "type": "reference",
          "resource": "Patient",
          "required": true
        },
        {
          "name": "drug",
          "type": "string",
          "required": true
        },
        {
          "name": "dose_mg",
          "type": "number",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": [
            "draft",
            "pending_review",
            "approved",
            "dispensed",
            "administered",
            "rejected"
          ]
        }
      ],
      "actions": [
        {
          "name": "Write",
          "type": "write"
        },
        {
          "name": "Review",
          "type": "write"
        },
        {
          "name": "Approve",
          "type": "write"
        },
        {
          "name": "Reject",
          "type": "write"
        },
        {
          "name": "Administer",
          "type": "write"
        }
      ],
      "domain": "inpatient"
    }
  ],
  "persons": [
    {
      "id": "dc4354de-db53-4704-9646-1fb3e568998d",
      "type": "person",
      "version": "1",
      "name": "Patient",
      "description": "An admitted person under care. Person template — structure with medical attributes and lifecycle (Admit, Discharge). Per-Patient Roles like AttendingPhysician scope directly to this Person (Role.scope = Patient).",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "mrn",
          "type": "string",
          "required": true,
          "description": "Medical record number"
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "admitted_at",
          "type": "datetime"
        },
        {
          "name": "ward",
          "type": "string"
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": [
            "admitted",
            "discharged",
            "transferred"
          ]
        }
      ],
      "actions": [
        {
          "name": "Admit",
          "type": "write"
        },
        {
          "name": "Discharge",
          "type": "write"
        },
        {
          "name": "Transfer",
          "type": "write"
        }
      ],
      "domain": "inpatient"
    },
    {
      "id": "65a504b3-5ce1-490d-8ff8-365eac8cccb2",
      "type": "person",
      "version": "1",
      "name": "Doctor",
      "description": "Physician; eligible for the AttendingPhysician and ConsultingSpecialist Roles.",
      "domain": "inpatient"
    },
    {
      "id": "abbe6345-3d97-49dc-8631-ef5ea9885505",
      "type": "person",
      "version": "1",
      "name": "Nurse",
      "description": "Nursing staff; eligible for the PrimaryNurse Role.",
      "domain": "inpatient"
    },
    {
      "id": "71be286a-08dd-48fc-be66-78aa69ccce31",
      "type": "person",
      "version": "1",
      "name": "PharmacyStaff",
      "description": "Pharmacy worker; eligible for the Pharmacist Role.",
      "domain": "inpatient"
    }
  ],
  "positions": [
