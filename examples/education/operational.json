        }
      ],
      "name": "CourseOfferingOpenAccess"
    },
    {
      "id": "47c5f477-0222-4719-89fd-8627732fccf4",
      "type": "rule",
      "version": "1",
      "operation": "CourseOffering.Close",
      "subtype": "access",
      "allow": [
        {
          "role": "Registrar"
        }
      ],
      "name": "CourseOfferingCloseAccess"
    },
    {
      "id": "e50ce0fe-08e9-4044-ac57-a8f20711504f",
      "type": "rule",
      "version": "1",
      "operation": "CourseOffering.Begin",
      "subtype": "access",
      "allow": [
        {
          "role": "Registrar"
        }
      ],
      "name": "CourseOfferingBeginAccess"
    },
    {
      "id": "610f87a4-6b60-4daf-a8d2-4dfa669daebb",
      "type": "rule",
      "version": "1",
      "operation": "CourseOffering.Finalize",
      "subtype": "access",
      "allow": [
        {
          "role": "Instructor"
        }
      ],
      "name": "CourseOfferingFinalizeAccess"
    },
    {
      "id": "f8842cd8-0c3b-47f1-8317-d2b6ff5453e4",
      "type": "rule",
      "version": "1",
      "operation": "Enrollment.Request",
      "subtype": "access",
      "allow": [
        {
          "role": "Student"
        }
      ],
      "name": "EnrollmentRequestAccess"
    },
    {
      "id": "72c9950c-1a26-408d-8d83-afa4b7fafa2a",
      "type": "rule",
      "version": "1",
      "operation": "Enrollment.Confirm",
      "subtype": "access",
      "allow": [
        {
          "role": "Registrar"
        }
      ],
      "name": "EnrollmentConfirmAccess"
    },
    {
      "id": "cfe38d64-f86f-4ffa-8deb-59f71e206cb5",
      "type": "rule",
      "version": "1",
      "operation": "Enrollment.Drop",
      "subtype": "access",
      "allow": [
        {
          "role": "Student",
          "ownership": true
        },
        {
          "role": "Registrar"
        }
      ],
      "name": "EnrollmentDropAccess"
    },
    {
      "id": "e5006255-1c68-4b56-911b-2e007cdf3ecc",
      "type": "rule",
      "version": "1",
      "operation": "Coursework.Submit",
      "subtype": "access",
      "allow": [
        {
          "role": "Student",
          "ownership": true
        }
      ],
      "name": "CourseworkSubmitAccess"
    },
    {
      "id": "9ce71389-80f3-4e15-8886-2a4dc620e00a",
      "type": "rule",
      "version": "1",
      "operation": "Coursework.Grade",
      "subtype": "access",
      "allow": [
        {
          "role": "Instructor"
        }
      ],
      "name": "CourseworkGradeAccess"
    },
    {
      "id": "539de792-ce77-4854-b875-377dc51556a1",
      "type": "rule",
      "version": "1",
      "name": "OfferingIsOpen",
      "operation": "Enrollment.Request",
      "subtype": "condition",
      "conditions": [
        {
          "attribute": "course_offering.status",
          "operator": "eq",
          "value": "open"
        }
      ]
    },
    {
      "id": "2fe258c7-3f57-4d42-a868-29e719364904",
      "type": "rule",
      "version": "1",
      "name": "SeatsAvailable",
      "operation": "Enrollment.Confirm",
      "subtype": "condition",
      "conditions": [
        {
          "attribute": "course_offering.enrolled_count",
          "operator": "lt",
          "value": 999
        }
      ]
    },
    {
      "id": "776f56d7-ed14-4d49-9d6f-1bde9dce9022",
      "type": "rule",
      "version": "1",
      "name": "OfferingInSession",
      "operation": "Coursework.Submit",
      "subtype": "condition",
      "conditions": [
        {
          "attribute": "course_offering.status",
          "operator": "eq",
          "value": "in_session"
        }
      ]
    },
    {
      "id": "dc13418b-d326-420e-98bd-4d265258b279",
      "type": "rule",
      "version": "1",
      "name": "AllCourseworkGraded",
      "operation": "CourseOffering.Finalize",
      "subtype": "condition",
      "conditions": [
        {
          "attribute": "course_offering.ungraded_coursework_count",
          "operator": "eq",
          "value": 0
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "6127ca4b-b9c7-4f00-9671-7dffdd65d843",
      "type": "relationship",
      "version": "1",
      "name": "CourseOffering.course",
      "from": "CourseOffering",
      "to": "Course",
      "cardinality": "many-to-one",
      "attribute": "course_id"
    },
    {
      "id": "5a3ca6a7-ae2f-422d-842c-1b6ba4f9f2ea",
      "type": "relationship",
      "version": "1",
      "name": "Enrollment.offering",
      "from": "Enrollment",
      "to": "CourseOffering",
      "cardinality": "many-to-one",
      "attribute": "offering_id"
    },
    {
      "id": "9193d4a1-8587-4bee-88f1-5cacc84e01c6",
      "type": "relationship",
      "version": "1",
      "name": "Coursework.offering",
      "from": "Coursework",
      "to": "CourseOffering",
      "cardinality": "many-to-one",
      "attribute": "offering_id"
    }
  ],
  "tasks": [
    {
      "id": "5025fb2b-5a55-454f-a43a-e49433104aad",
      "type": "task",
      "version": "1",
      "name": "request-enrollment",
      "actor": "Student",
      "operation": "Enrollment.Request"
    },
    {
      "id": "57d64947-51fb-4861-96b1-74d9dab8a83e",
      "type": "task",
      "version": "1",
      "name": "confirm-enrollment",
      "actor": "Registrar",
      "operation": "Enrollment.Confirm"
    },
    {
      "id": "182e1988-4ff2-4f94-ae28-972d5db93cf1",
      "type": "task",
      "version": "1",
      "name": "submit-coursework",
      "actor": "Student",
      "operation": "Coursework.Submit"
    },
    {
      "id": "fcc99e33-4e8b-471d-8e52-e6b9cf81cf82",
      "type": "task",
      "version": "1",
      "name": "grade-coursework",
      "actor": "Instructor",
      "operation": "Coursework.Grade"
    },
    {
      "id": "8420cd3b-acc8-4edf-849c-ffaee32c5d91",
      "type": "task",
      "version": "1",
      "name": "finalize-offering",
      "actor": "Instructor",
      "operation": "CourseOffering.Finalize"
    }
  ],
  "processes": [
    {
      "id": "5e2d4360-a926-434e-bb91-0fdcb18ccc7a",
      "type": "process",
      "version": "1",
      "name": "EnrollmentApproval",
      "description": "Student requests enrollment, Registrar confirms if seats remain.",
      "operator": "Registrar",
      "startStep": "request",
      "steps": [
        {
          "id": "request",
          "task": "request-enrollment",
          "conditions": [
            "OfferingIsOpen"
          ],
          "else": "abort"
        },
        {
          "id": "confirm",
          "task": "confirm-enrollment",
          "depends_on": [
            "request"
          ],
          "conditions": [
            "SeatsAvailable"
          ],
          "else": "abort"
        }
      ]
    },
    {
      "id": "8f689f45-1b4a-4c28-bfa0-d7f80faa507e",
      "type": "process",
      "version": "1",
      "name": "SemesterFinalization",
      "description": "End-of-semester: instructor finalizes the offering once all coursework is graded.",
      "operator": "Instructor",
      "startStep": "finalize",
      "steps": [
        {
          "id": "finalize",
          "task": "finalize-offering",
          "conditions": [
            "AllCourseworkGraded"
          ],
          "else": "abort"
        }
      ]
    }
  ]
}
