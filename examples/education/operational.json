  "triggers": [
    {
      "id": "3b94f3d5-a1be-48cd-a123-ad9e543bd228",
      "type": "trigger",
      "version": "1",
      "operation": "CourseOffering.Open",
      "source": "user",
      "name": "CourseOfferingOpenUser"
    },
    {
      "id": "e9d08a0e-8b21-483e-ad3f-2b3556409e47",
      "type": "trigger",
      "version": "1",
      "operation": "Enrollment.Request",
      "source": "user",
      "name": "EnrollmentRequestUser"
    },
    {
      "id": "da8b6573-a5b4-4237-93f0-be3918479620",
      "type": "trigger",
      "version": "1",
      "operation": "Coursework.Submit",
      "source": "user",
      "name": "CourseworkSubmitUser"
    },
    {
      "id": "34ce72b9-c5b4-442a-8583-9a6ffd233ece",
      "type": "trigger",
      "version": "1",
      "process": "EnrollmentApproval",
      "source": "operation",
      "after": "Enrollment.Request",
      "name": "EnrollmentApprovalOperation"
    },
    {
      "id": "55d061a4-77d6-4dfa-89fb-c97cc6a9c8b8",
      "type": "trigger",
      "version": "1",
      "operation": "CourseOffering.Begin",
      "source": "schedule",
      "schedule": "0 0 * 1 *",
      "description": "January start-of-month opens spring offerings into in-session.",
      "name": "CourseOfferingBeginSchedule"
    },
    {
      "id": "2bbf74d4-559c-4c0a-b114-d4708c9d9ce7",
      "type": "trigger",
      "version": "1",
      "process": "SemesterFinalization",
      "source": "schedule",
      "schedule": "0 0 15 5 *",
      "description": "Mid-May runs final-grade rollup for spring offerings.",
      "name": "SemesterFinalizationSchedule"
    }
  ],
  "rules": [
    {
      "id": "f0a799b8-9c44-492a-bf84-0b045d06007a",
      "type": "rule",
      "version": "1",
      "operation": "CourseOffering.Open",
