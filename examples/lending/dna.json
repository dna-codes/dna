    { "id": "position:origination-dir",       "type": "position",   "name": "Origination Director",    "description": "Leads the loan origination team, overseeing application intake, loan officer performance, and pipeline throughput." },
    { "id": "position:loan-officer",          "type": "position",   "name": "Loan Officer",            "description": "Guides applicants through the loan process from initial intake to funding, serving as the primary borrower contact." },
    { "id": "position:closing-coordinator",   "type": "position",   "name": "Closing Coordinator",     "description": "Prepares and coordinates all documentation and scheduling required to close a loan on time." },
    { "id": "position:chief-underwriter",     "type": "position",   "name": "Chief Underwriter",       "description": "Sets underwriting policy and makes final credit decisions on loan approvals, denials, and exceptions." },
    { "id": "position:underwriter",           "type": "position",   "name": "Underwriter",             "description": "Analyzes borrower creditworthiness and risk profile to prepare recommendations for the approval decision." },
    { "id": "position:servicing-mgr",         "type": "position",   "name": "Servicing Manager",       "description": "Manages the ongoing servicing of funded loans, including payment processing, escrow, and borrower inquiries." },
    { "id": "position:collections-lead",      "type": "position",   "name": "Collections Lead",        "description": "Leads collection efforts on delinquent accounts, managing outreach strategy and recovery workflows." },

