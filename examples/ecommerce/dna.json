{
  "name": "apex-commerce",
  "description": "Apex Commerce — e-commerce enterprise with Catalog, Orders, Fulfillment, and Payments departments.",
  "resources": [
    { "id": "company:apex",              "type": "company",    "name": "Apex Commerce" },

    { "id": "dept:catalog",              "type": "department", "name": "Catalog" },
    { "id": "dept:orders",               "type": "department", "name": "Orders" },
