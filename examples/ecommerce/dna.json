    { "id": "position:chief-merchant",   "type": "position",   "name": "Chief Merchant",        "description": "Owns the product catalog strategy and coordinates across catalog, orders, fulfillment, and payments to drive commercial outcomes." },
    { "id": "position:catalog-mgr",      "type": "position",   "name": "Catalog Manager",       "description": "Maintains product catalog accuracy and completeness, ensuring listings meet quality and metadata standards." },
    { "id": "position:orders-dir",       "type": "position",   "name": "Orders Director",       "description": "Oversees the end-to-end order lifecycle, from receipt through handoff to fulfillment, and resolves order exceptions." },
    { "id": "position:fulfillment-mgr",  "type": "position",   "name": "Fulfillment Manager",   "description": "Manages warehouse pick-pack operations and coordinates fulfillment staff to meet SLA targets." },
    { "id": "position:fulfillment-assoc","type": "position",   "name": "Fulfillment Associate", "description": "Executes physical pick, pack, and ship tasks and confirms successful delivery with carriers." },
    { "id": "position:payments-dir",     "type": "position",   "name": "Payments Director",     "description": "Leads the payments function, overseeing transaction processing, dispute resolution, and fraud escalation." },
    { "id": "position:payments-analyst", "type": "position",   "name": "Payments Analyst",      "description": "Monitors payment transactions, logs incidents, and executes retry workflows to recover failed payments." },
    { "id": "position:fraud-analyst",    "type": "position",   "name": "Fraud Analyst",         "description": "Detects and investigates fraudulent payment activity, triaging incidents before escalation." },

    { "id": "person:jordan-taylor",      "type": "person",     "name": "Jordan Taylor" },
