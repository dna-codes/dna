    { "id": "position:paralegal",        "type": "position",   "name": "Paralegal",          "description": "Supports litigation with document management, filing, and procedural coordination." },

    { "id": "position:client-dir",       "type": "position",   "name": "Client Director",    "description": "Leads the Client Services department, ensuring a high-quality client experience from onboarding through ongoing case updates." },
    { "id": "position:coordinator",      "type": "position",   "name": "Coordinator",        "description": "Manages client-facing onboarding steps including welcome calls, intake form completion, and coordinator assignments." },

