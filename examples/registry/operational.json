{
  "domain": {
    "name": "registry",
    "description": "A type-driven resource management platform. TypeDefinitions describe what data shapes the platform supports; Instances are validated runtime records of those types; Links capture typed relationships (plain references and role assignments). Demonstrates that DNA's existing Operational primitives express a generic config-vs-instance meta-pattern with no schema extensions."
  },
  "resources": [
    {
      "id": "c456464a-cab9-4621-a3b8-7e443a13934c",
      "type": "resource",
      "version": "1",
      "name": "TypeDefinition",
      "description": "A configuration template that declares a runtime type. Every Instance in the registry validates against the TypeDefinition referenced by its `type_def` attribute.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "type_name",
          "type": "string",
          "required": true,
          "description": "Platform-level name of the type (e.g., 'person', 'case', 'plaintiff', 'loan')."
        },
        {
          "name": "category",
          "type": "enum",
          "required": true,
          "values": [
            "person",
            "role",
            "group",
            "resource",
            "domain"
          ],
          "description": "Classifies what kind of noun this type produces. Mirrors DNA's noun-primitive distinction at the platform's data-model layer."
        },
        {
          "name": "attribute_schema",
          "type": "text",
          "required": true,
          "description": "JSON-Schema fragment that Instances of this type must validate against."
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "values": [
            "draft",
            "published",
            "archived"
          ]
        }
      ],
      "actions": [
        {
          "name": "Create",
          "description": "Author a new draft TypeDefinition.",
          "type": "write"
        },
        {
          "name": "Publish",
          "description": "Promote a draft to published; Instances may now be created against it.",
          "type": "write"
        },
        {
          "name": "Archive",
          "description": "Retire a published type from further Instance creation.",
          "type": "destructive"
        }
      ],
      "domain": "registry"
    },
    {
      "id": "d441c9bf-3a75-4988-9df3-3bb0547ebccf",
      "type": "resource",
      "version": "1",
      "name": "Instance",
      "description": "A runtime record validated against its TypeDefinition. `data` carries the payload, `type_def` references the governing TypeDefinition.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "type_def",
          "type": "reference",
          "resource": "TypeDefinition",
          "required": true
        },
        {
          "name": "data",
          "type": "text",
          "required": true,
          "description": "JSON payload conforming to the TypeDefinition's attribute_schema."
        },
        {
          "name": "validation_status",
          "type": "enum",
          "values": [
            "valid",
            "invalid",
            "stale"
          ],
          "description": "Last computed result of running the ValidationEngine against `data`."
        }
      ],
      "actions": [
        {
          "name": "Create",
          "description": "Persist a new Instance for a published type.",
          "type": "write"
        },
        {
          "name": "Update",
          "description": "Modify an Instance's data payload or re-run validation.",
          "type": "write"
        },
        {
          "name": "Delete",
          "description": "Remove an Instance from the registry.",
          "type": "destructive"
        }
      ],
      "domain": "registry"
    },
    {
      "id": "f899ad51-c914-47a2-a2da-7413d5e6c018",
      "type": "resource",
      "version": "1",
      "name": "Link",
      "description": "A typed relationship between two Instances. `role` distinguishes plain references ('belongs_to') from role assignments ('lead_counsel') without requiring a separate primitive.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "from",
          "type": "reference",
          "resource": "Instance",
          "required": true
        },
        {
          "name": "to",
          "type": "reference",
          "resource": "Instance",
          "required": true
        },
        {
          "name": "role",
          "type": "string",
          "description": "Optional role name when the Link represents a role assignment (e.g., 'lead_counsel', 'attending_physician'). Omitted for plain references."
        },
        {
          "name": "attributes",
          "type": "text",
          "description": "Optional JSON payload carrying role-specific attributes (e.g., assigned_at, scope)."
        }
      ],
      "actions": [
        {
          "name": "Create",
          "description": "Establish a Link between two Instances.",
          "type": "write"
        },
        {
          "name": "Delete",
          "description": "Remove a Link.",
          "type": "destructive"
        }
      ],
      "domain": "registry"
    },
    {
      "id": "57ed826d-2078-4675-8a17-e206ae350bdb",
      "type": "resource",
      "version": "1",
      "name": "ValidationService",
      "description": "The platform's automated schema-validation actor. Backs the ValidationEngine Role's `resource:` link, mirroring the lending example's NightlyDelinquencySweep pattern.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "last_run_at",
          "type": "datetime"
        }
      ],
      "domain": "registry"
    }
  ],
  "persons": [
    {
      "id": "3858fdb8-a636-401f-8ef3-d489be061cd1",
      "type": "person",
      "version": "1",
      "name": "Administrator",
      "description": "Platform administrator who designs TypeDefinitions and manages registry-wide configuration.",
      "domain": "registry"
    },
    {
      "id": "23ee5a24-18c8-40e9-af1e-05ffea087047",
      "type": "person",
      "version": "1",
      "name": "Operator",
      "description": "Day-to-day registry user who creates Instances and Links against published TypeDefinitions.",
      "domain": "registry"
    }
  ],
  "positions": [
    {
      "id": "4225095e-c96b-41e7-ac0b-282cb25a6e0d",
      "type": "position",
      "version": "1",
      "name": "TypeDesigner",
      "description": "Authors and publishes TypeDefinitions.",
      "scope": "Registry",
      "domain": "registry"
    },
    {
      "id": "98ab16c9-9890-4681-a3ee-05f7fc8b6d2f",
      "type": "position",
      "version": "1",
      "name": "DataManager",
      "description": "Creates, updates, deletes Instances and Links against published types.",
      "scope": "Registry",
      "domain": "registry"
    },
    {
      "id": "9cfa0a8d-d7fd-4598-a8b6-4a72837ad75c",
      "type": "position",
      "version": "1",
      "name": "Viewer",
      "description": "Read-only access to TypeDefinitions, Instances, and Links.",
      "scope": "Registry",
      "domain": "registry"
    },
    {
      "id": "3473b757-d998-473a-b4b3-e630b26f3f78",
      "type": "position",
      "version": "1",
      "name": "ValidationEngine",
      "description": "System actor that runs schema validation on Instances. Same pattern as NightlyDelinquencySweep (lending) and the manufacturing system Roles.",
      "system": true,
      "resource": "ValidationService",
      "domain": "registry"
    }
  ],
  "groups": [
    {
      "id": "81d17863-301b-42f8-8636-b3a0825fcba1",
      "type": "group",
      "version": "1",
      "name": "Registry",
      "description": "The container Group within which the registry's Roles are exercised.",
      "domain": "registry"
    }
  ],
  "memberships": [
    {
      "id": "77d292b3-0461-44dd-ad39-1ccc7b995314",
      "type": "membership",
      "version": "1",
      "name": "AdminTypeDesigner",
      "person": "Administrator",
      "position": "TypeDesigner",
      "description": "Administrators may hold the TypeDesigner role within the Registry."
    },
    {
      "id": "ef4498fe-0e46-48f0-b9fc-583b71fccad9",
      "type": "membership",
      "version": "1",
      "name": "AdminDataManager",
      "person": "Administrator",
      "position": "DataManager",
      "description": "Administrators may also act as DataManagers."
    },
    {
      "id": "d7ebfa14-c34c-44f2-af03-fa97c126bb88",
      "type": "membership",
      "version": "1",
      "name": "OperatorDataManager",
      "person": "Operator",
      "position": "DataManager",
      "description": "Operators are DataManagers by default."
    },
    {
      "id": "b0170180-43c5-4a0e-a433-bd077e91cf9e",
      "type": "membership",
      "version": "1",
      "name": "OperatorViewer",
      "person": "Operator",
      "position": "Viewer",
      "description": "Operators may also hold the read-only Viewer role."
    }
  ],
  "operations": [
    {
      "id": "3b8f5e36-1756-4875-838c-a405899a24ec",
      "type": "operation",
      "version": "1",
      "target": "TypeDefinition",
      "action": "Create",
      "name": "TypeDefinition.Create",
      "changes": [
        {
          "attribute": "status",
          "set": "draft"
        }
      ]
    },
    {
      "id": "746f6a59-3403-4227-b74b-6ab4874e8ab4",
      "type": "operation",
      "version": "1",
      "target": "TypeDefinition",
      "action": "Publish",
      "name": "TypeDefinition.Publish",
      "changes": [
        {
          "attribute": "status",
          "set": "published"
        }
      ]
    },
    {
      "id": "c6fb77fa-a48a-4510-abc1-003f63a6cd3d",
      "type": "operation",
      "version": "1",
      "target": "TypeDefinition",
      "action": "Archive",
      "name": "TypeDefinition.Archive",
      "changes": [
        {
          "attribute": "status",
          "set": "archived"
        }
      ]
    },
    {
      "id": "b911df31-024d-4b14-bcf9-07fe82e29792",
      "type": "operation",
      "version": "1",
      "target": "Instance",
      "action": "Create",
      "name": "Instance.Create",
      "changes": [
        {
          "attribute": "validation_status",
          "set": "stale"
        }
      ]
    },
    {
      "id": "fe1ad500-f6a3-4f24-b37a-c97e25862da6",
      "type": "operation",
      "version": "1",
      "target": "Instance",
      "action": "Update",
      "name": "Instance.Update"
    },
    {
      "id": "a62c279c-709d-480a-b074-c1ebabb53a77",
      "type": "operation",
      "version": "1",
      "target": "Instance",
      "action": "Delete",
      "name": "Instance.Delete"
    },
    {
      "id": "42be737e-e329-4cfa-95ab-17594338631d",
      "type": "operation",
      "version": "1",
      "target": "Link",
      "action": "Create",
      "name": "Link.Create"
    },
    {
      "id": "272bbf25-7c36-4d37-a0a4-3fef35ccfdaa",
      "type": "operation",
      "version": "1",
      "target": "Link",
      "action": "Delete",
      "name": "Link.Delete"
    }
  ],
  "triggers": [
    {
      "id": "562d6af0-43c6-40a2-8034-1ebebbb8612c",
      "type": "trigger",
      "version": "1",
      "name": "TypeDefinitionCreateUser",
      "operation": "TypeDefinition.Create",
      "source": "user",
      "description": "TypeDesigner authors a new TypeDefinition through the admin UI."
    },
    {
      "id": "531ae663-4776-48da-94cd-6ff820dfbffc",
      "type": "trigger",
      "version": "1",
      "name": "TypeDefinitionPublishedBootstrap",
      "process": "InstanceBootstrap",
      "source": "operation",
      "after": "TypeDefinition.Publish",
      "description": "Publishing a TypeDefinition kicks off the InstanceBootstrap Process so platform tooling can seed example Instances and notify integrations."
    },
    {
      "id": "2df989b7-3fa0-452d-ac65-da676b5bef7f",
      "type": "trigger",
      "version": "1",
      "name": "InstanceCreateWebhook",
      "operation": "Instance.Create",
      "source": "webhook",
      "event": "external.instance.created",
      "description": "Upstream system pushes an Instance via the platform's ingest webhook."
    },
    {
      "id": "3cd74d9e-5b07-48c3-b5c4-72a3033f6393",
      "type": "trigger",
      "version": "1",
      "name": "NightlyValidationSweep",
      "operation": "Instance.Update",
      "source": "schedule",
      "schedule": "0 2 * * *",
      "description": "Cron job that re-runs validation across stale Instances. The ValidationEngine access rule on Instance.Update authorizes this system actor."
    },
    {
      "id": "bc2bcac8-04d5-4c45-85e3-5ea08125af40",
      "type": "trigger",
      "version": "1",
      "name": "LinkCreateUser",
      "operation": "Link.Create",
      "source": "user",
      "description": "DataManager creates a Link between two Instances through the UI."
    }
  ],
  "rules": [
    {
      "id": "e10875d9-ed01-4092-8bb9-8f1c43c152ca",
      "type": "rule",
      "version": "1",
      "name": "TypeDefinitionCreateAccess",
      "operation": "TypeDefinition.Create",
      "rule_type": "access",
      "allow": [
        {
          "role": "TypeDesigner"
        }
      ]
    },
    {
      "id": "b6681751-d29b-432a-a855-959a5f98b733",
      "type": "rule",
      "version": "1",
      "name": "TypeDefinitionPublishAccess",
      "operation": "TypeDefinition.Publish",
      "rule_type": "access",
      "allow": [
        {
          "role": "TypeDesigner"
        }
      ]
    },
    {
      "id": "63703192-5d28-4967-9425-3b7acb939b0f",
      "type": "rule",
      "version": "1",
      "name": "TypeDefinitionArchiveAccess",
      "operation": "TypeDefinition.Archive",
      "rule_type": "access",
      "allow": [
        {
          "role": "TypeDesigner"
        }
      ]
    },
    {
      "id": "734fb15a-6b12-4659-8edb-1c347fdc34b6",
      "type": "rule",
      "version": "1",
      "name": "InstanceCreateAccess",
      "operation": "Instance.Create",
      "rule_type": "access",
      "allow": [
        {
          "role": "DataManager"
        }
      ]
    },
    {
      "id": "dc465dda-5c25-4110-afc6-258879be5711",
      "type": "rule",
      "version": "1",
      "name": "InstanceUpdateByDataManager",
      "operation": "Instance.Update",
      "rule_type": "access",
      "allow": [
        {
          "role": "DataManager"
        }
      ]
    },
    {
      "id": "55ad7cd5-1374-4cd3-a409-98846f5494b8",
      "type": "rule",
      "version": "1",
      "name": "InstanceUpdateByValidationEngine",
      "operation": "Instance.Update",
      "rule_type": "access",
      "allow": [
        {
          "role": "ValidationEngine"
        }
      ],
      "description": "Separate access entry so the system-actor wiring stays visible alongside the human DataManager rule."
    },
    {
      "id": "d2ce263f-f6b3-48c9-a1b0-4559ba92b8aa",
      "type": "rule",
      "version": "1",
      "name": "InstanceDeleteAccess",
      "operation": "Instance.Delete",
      "rule_type": "access",
      "allow": [
        {
          "role": "DataManager"
        }
      ]
    },
    {
      "id": "acf3eb01-9ef9-4c37-a128-fec02806c03e",
      "type": "rule",
      "version": "1",
      "name": "LinkCreateAccess",
      "operation": "Link.Create",
      "rule_type": "access",
      "allow": [
        {
          "role": "DataManager"
        }
      ]
    },
    {
      "id": "198b9b04-2237-4a19-b84a-4ec49bead55e",
      "type": "rule",
      "version": "1",
      "name": "LinkDeleteAccess",
      "operation": "Link.Delete",
      "rule_type": "access",
      "allow": [
        {
          "role": "DataManager"
        }
      ]
    },
    {
      "id": "e9c22320-c488-4efa-b286-4a853f44c899",
      "type": "rule",
      "version": "1",
      "name": "TypeIsNotRole",
      "operation": "Instance.Create",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "type_def.category",
          "operator": "neq",
          "value": "role"
        }
      ],
      "description": "Role-category TypeDefinitions don't produce Instances — role assignments are Links with `role:` set instead."
    },
    {
      "id": "9f3914a3-8afe-4612-9afa-1940a35e6f91",
      "type": "rule",
      "version": "1",
      "name": "TypeIsPublished",
      "operation": "Instance.Create",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "type_def.status",
          "operator": "eq",
          "value": "published"
        }
      ],
      "description": "Only published TypeDefinitions accept new Instances."
    },
    {
      "id": "028f84bd-fe67-4b22-8b41-195ef5e46b7d",
      "type": "rule",
      "version": "1",
      "name": "PublishOnlyDrafts",
      "operation": "TypeDefinition.Publish",
      "rule_type": "condition",
      "conditions": [
        {
          "attribute": "status",
          "operator": "eq",
          "value": "draft"
        }
      ],
      "description": "Only draft TypeDefinitions may be published; archived or already-published types cannot transition back through Publish."
    }
  ],
  "relationships": [
    {
      "id": "11111111-2222-3333-4444-555555555501",
      "type": "relationship",
      "version": "1",
      "name": "InstanceOfType",
      "from": "Instance",
      "to": "TypeDefinition",
      "cardinality": "many-to-one",
      "attribute": "type_def",
      "inverse": "instances"
    },
    {
      "id": "11111111-2222-3333-4444-555555555502",
      "type": "relationship",
      "version": "1",
      "name": "LinkFrom",
      "from": "Link",
      "to": "Instance",
      "cardinality": "many-to-one",
      "attribute": "from",
      "inverse": "outbound_links"
    },
    {
      "id": "11111111-2222-3333-4444-555555555503",
      "type": "relationship",
      "version": "1",
      "name": "LinkTo",
      "from": "Link",
      "to": "Instance",
      "cardinality": "many-to-one",
      "attribute": "to",
      "inverse": "inbound_links"
    }
  ],
  "tasks": [
    {
      "id": "22222222-3333-4444-5555-666666666601",
      "type": "task",
      "version": "1",
      "name": "design-type",
      "actor": "TypeDesigner",
      "operation": "TypeDefinition.Create"
    },
    {
      "id": "22222222-3333-4444-5555-666666666602",
      "type": "task",
      "version": "1",
      "name": "publish-type",
      "actor": "TypeDesigner",
      "operation": "TypeDefinition.Publish"
    },
    {
      "id": "22222222-3333-4444-5555-666666666603",
      "type": "task",
      "version": "1",
      "name": "create-instance",
      "actor": "DataManager",
      "operation": "Instance.Create"
    },
    {
      "id": "22222222-3333-4444-5555-666666666604",
      "type": "task",
      "version": "1",
      "name": "update-instance",
      "actor": "DataManager",
      "operation": "Instance.Update"
    },
    {
      "id": "22222222-3333-4444-5555-666666666605",
      "type": "task",
      "version": "1",
      "name": "link-instances",
      "actor": "DataManager",
      "operation": "Link.Create"
    },
    {
      "id": "22222222-3333-4444-5555-666666666606",
      "type": "task",
      "version": "1",
      "name": "validate-instance",
      "actor": "ValidationEngine",
      "operation": "Instance.Update"
    }
  ],
  "processes": [
    {
      "id": "33333333-4444-5555-6666-777777777701",
      "type": "process",
      "version": "1",
      "name": "TypeOnboarding",
      "description": "TypeDesigner authors a TypeDefinition, then publishes it to make the type live.",
      "operator": "TypeDesigner",
      "startStep": "design",
      "steps": [
        {
          "id": "design",
          "task": "design-type"
        },
        {
          "id": "publish",
          "task": "publish-type",
          "depends_on": [
            "design"
          ]
        }
      ]
    },
    {
      "id": "33333333-4444-5555-6666-777777777702",
      "type": "process",
      "version": "1",
      "name": "InstanceBootstrap",
      "description": "Triggered by TypeDefinition.Publish: seeds the registry with a baseline Instance for the newly-published type and runs validation. Demonstrates a Process-level Trigger off a config-primitive lifecycle Operation.",
      "operator": "DataManager",
      "startStep": "create",
      "steps": [
        {
          "id": "create",
          "task": "create-instance"
        },
        {
          "id": "validate",
          "task": "validate-instance",
          "depends_on": [
            "create"
          ],
          "conditions": [
            "TypeIsPublished",
            "TypeIsNotRole"
          ]
        }
      ]
    },
    {
      "id": "33333333-4444-5555-6666-777777777703",
      "type": "process",
      "version": "1",
      "name": "LinkLifecycle",
      "description": "DataManager creates a Link between two Instances.",
      "operator": "DataManager",
      "startStep": "link",
      "steps": [
        {
          "id": "link",
          "task": "link-instances"
        }
      ]
    }
  ]
}
