{
  "resources": [
    {
      "id": "m2",
      "type": "module",
      "props": {
        "name": "Module 2",
        "className": "space-y-4"
      }
    },
    {
      "id": "m2-headrow",
      "type": "box",
      "props": {
        "className": "flex items-center gap-3"
      }
    },
    {
      "id": "m2-title",
      "type": "heading",
      "props": {
        "level": 2,
        "text": "Module 2 — Machine",
        "className": "text-ui-lg font-ui-semibold"
      }
    },
    {
      "id": "m2-badge",
      "type": "badge",
      "props": {
        "variant": "primary",
        "text": "XState"
      }
    },
    {
      "id": "m2-desc",
      "type": "text",
      "props": {
        "text": "A headless Machine.Root (declared once at the shell level) drives this content lifecycle. The trail shows where it is; each state offers only its valid next moves. The inspector on the right tracks the same actor live.",
        "className": "text-ui-text-muted"
      }
    },
    {
      "id": "m2-card",
      "type": "card"
    },
    {
      "id": "m2-body",
      "type": "box",
      "props": {
        "className": "space-y-5"
      }
    },
    {
      "id": "m2-flow",
      "type": "flow-steps",
      "props": {
        "steps": [
          {
            "value": "draft",
            "label": "Draft"
          },
          {
            "value": "inReview",
            "label": "In review"
          },
          {
            "value": "approved",
            "label": "Approved"
          },
          {
            "value": "published",
            "label": "Published"
          },
          {
            "value": "archived",
            "label": "Archived"
          }
        ]
      }
    },
    {
      "id": "m2-sep",
      "type": "separator"
    },
