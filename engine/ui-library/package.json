{
  "name": "@dna/ui-library",
  "version": "0.0.0",
  "description": "A headless, unstyled, accessible React component library built on Radix UI, with Storybook.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./styles.css": "./dist/ui-library.css",
    "./skin.css": "./dist/skin.css",
    "./dna.css": "./dist/dna.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "gen:skin": "node scripts/gen-skin.mjs",
    "build": "npm run gen:skin && vite build && node -e \"const fs=require('fs');fs.copyFileSync('src/styles/tokens.css','dist/ui-library.css');fs.copyFileSync('src/styles/skin.css','dist/skin.css');fs.copyFileSync('src/styles/dna.css','dist/dna.css')\"",
    "typecheck": "tsc --noEmit",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --project unit run",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest --project storybook run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.4.2",
    "jsdom": "^29.0.0",
    "playwright": "^1.60.0",
    "postcss-js": "^4.1.0",
    "prettier": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.4.2",
    "typescript": "^5.5.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@xstate/react": "^5.0.5",
    "radix-ui": "^1.5.0",
    "xstate": "^5.32.0"
  }
}
