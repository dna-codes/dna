# Anthropic API key for Claude
ANTHROPIC_API_KEY=your_api_key_here

# URL of the running DNA MCP Server (packages/mcp)
# For local dev: start the MCP server separately, e.g. `node dist/bin.js`
DNA_MCP_URL=http://localhost:3300/mcp

# Neo4j connection (used by the MCP server, not directly by this app)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
