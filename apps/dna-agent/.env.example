# Anthropic API key for Claude
ANTHROPIC_API_KEY=your_api_key_here

# URL of the running DNA MCP Server (packages/mcp)
# For local dev: start the MCP server separately, e.g. `node dist/bin.js`
DNA_MCP_URL=http://localhost:3300/mcp

# Persistence / Neo4j is configured on the MCP SERVER process, not here — this
# app only talks to it over HTTP via DNA_MCP_URL above. To persist the graph,
# set NEO4J_* in packages/mcp/.env (see packages/mcp/.env.example).
